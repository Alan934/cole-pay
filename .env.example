# PostgreSQL connection string
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/colepay?schema=public"

# NextAuth / Auth.js — generar con: npx auth secret  (o cualquier string aleatorio largo)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL base de la app (en desarrollo)
AUTH_URL="http://localhost:3000"

# Secreto del cron diario que acredita los rendimientos (/api/cron/accrual).
# Sin esta variable el endpoint no ejecuta nada. En Vercel, cargala en
# Settings → Environment Variables: Vercel Cron la manda como Bearer token.
CRON_SECRET="cambia-esto-por-otro-secreto-largo-y-aleatorio"
